<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.bmstu.baumanets</string>
	<key>WorkingDirectory</key>
	<string>/Users/akkeup/test</string>
	<key>ProgramArguments</key>
	<array>
		<string>/bin/zsh</string>
		<string>-lc</string>
		<string>set -a; source .env; set +a; exec ./bot</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>/Users/akkeup/test/data/bot.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/akkeup/test/data/bot.log</string>
</dict>
</plist>
